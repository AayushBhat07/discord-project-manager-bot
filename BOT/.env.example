# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_client_id
GUILD_ID=your_discord_server_id

# GitHub Configuration
GITHUB_PAT=your_github_personal_access_token
TARGET_REPO_PATH=./repo
TARGET_REPO_REMOTE=https://github.com/username/repo.git
TARGET_REPO_BRANCH=main

# AI Configuration (Ollama - local AI)
AI_ENABLED=true
AI_API_URL=http://localhost:11434
AI_MODEL=auto

# Credential Storage (for multi-user support on server)
USER_CONFIG_KEY=your_32_char_config_key_here

# Scheduler Configuration
MAX_SCHEDULED_JOBS=50
MAX_JOBS_PER_USER=10

# Session Manager Configuration
SESSION_RETENTION_DAYS=30
SESSION_INACTIVITY_DAYS=7

# TEMP Repository Configuration
TEMP_REPO_ENABLED=true
TEMP_REPO_PATH=./TEMP_REPO